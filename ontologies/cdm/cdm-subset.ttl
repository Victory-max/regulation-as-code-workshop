    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Account> ;
    rdfs:label "Account.accountName" ;
    skos:notation "cdm.base.staticdata.party.Account.accountName" ;
    skos:definition "The name by which the account is known." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Account> ;
    rdfs:range xsd:string ;
    skos:scopeNote "cardinality 0..1" .

