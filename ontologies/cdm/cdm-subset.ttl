    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> a owl:Class , skos:Concept ;
    rdfs:label "AssetTypeEnum" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetTypeEnum" ;
