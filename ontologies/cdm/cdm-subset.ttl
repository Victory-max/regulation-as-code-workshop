    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-asset-common-enum.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum/Security> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> ;
    rdfs:label "Security" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetTypeEnum.Security" ;
    skos:definition "Identifies negotiable financial instrument of monetary value with an issue ownership position." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum/Cash> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> ;
    rdfs:label "Cash" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetTypeEnum.Cash" ;
    skos:definition "Identifies cash in a currency form." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum/Commodity> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> ;
    rdfs:label "Commodity" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetTypeEnum.Commodity" ;
    skos:definition "Identifies basic good used in commerce that is interchangeable with other goods of the same type." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum/ListedDerivative> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> ;
    rdfs:label "ListedDerivative" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetTypeEnum.ListedDerivative" ;
    skos:definition "Identifies an asset as a listed derivative on an exchange." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum/Loan> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> ;
    rdfs:label "Loan" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetTypeEnum.Loan" ;
    skos:definition "An asset that represents a loan or borrow obligation." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum/LetterOfCredit> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> ;
    rdfs:label "LetterOfCredit" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetTypeEnum.LetterOfCredit" ;
    skos:definition "Identifies an asset as a letter of credit or documentary credit/ bankers commercial credit.  A payment mechanism used in international trade to provide economic guarantee of payment by a creditworthy issuer for payment of exported goods." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum/Other> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> ;
    rdfs:label "Other" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetTypeEnum.Other" ;
    skos:definition "Identifies other asset types." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> a owl:Class , skos:Concept ;
    rdfs:label "SecurityTypeEnum" ;
    skos:notation "cdm.base.staticdata.asset.common.SecurityTypeEnum" ;
    skos:definition "Represents an enumeration list to indentify the type of a security." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-asset-common-enum.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum/Debt> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> ;
    rdfs:label "Debt" ;
    skos:notation "cdm.base.staticdata.asset.common.SecurityTypeEnum.Debt" ;
    skos:definition "Identifies a security as a fixed income security of debt issued and securitized as a tradable asset." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum/Equity> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> ;
    rdfs:label "Equity" ;
    skos:notation "cdm.base.staticdata.asset.common.SecurityTypeEnum.Equity" ;
    skos:definition "Identifies a security as an Equity value of holding of shares in listed company." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum/Fund> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> ;
    rdfs:label "Fund" ;
    skos:notation "cdm.base.staticdata.asset.common.SecurityTypeEnum.Fund" ;
    skos:definition "Identifies a security as representing holding in an investment fund." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum/Warrant> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> ;
    rdfs:label "Warrant" ;
    skos:notation "cdm.base.staticdata.asset.common.SecurityTypeEnum.Warrant" ;
    skos:definition "Identifies a security as a Warrant that give the right, but not the obligation, to buy or sell a security — most commonly an equity — at a certain price before expiration, or to receive the cash equivalent." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum/Certificate> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> ;
    rdfs:label "Certificate" ;
    skos:notation "cdm.base.staticdata.asset.common.SecurityTypeEnum.Certificate" ;
    skos:definition "Identifies a security as one that that offers a derivative-based economic return which is not structured as a bond, an equity or a warrant. Note that this security type is not a Certificate of Deposit (aka CD)." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> a owl:Class , skos:Concept ;
    rdfs:label "EquityTypeEnum" ;
    skos:notation "cdm.base.staticdata.asset.common.EquityTypeEnum" ;
    skos:definition "Represents an enumeration list to identify the type of Equity." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-asset-common-enum.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum/Ordinary> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> ;
    rdfs:label "Ordinary" ;
    skos:notation "cdm.base.staticdata.asset.common.EquityTypeEnum.Ordinary" ;
    skos:definition "Identifies an Equity of Common stocks and shares." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum/NonConvertiblePreference> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> ;
    rdfs:label "NonConvertiblePreference" ;
    skos:notation "cdm.base.staticdata.asset.common.EquityTypeEnum.NonConvertiblePreference" ;
    skos:definition "Identifies an Equity of Non-Convertible Preference, Shares which hold priority to receive capital return in event of issuer liquidation." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum/DepositaryReceipt> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> ;
    rdfs:label "DepositaryReceipt" ;
    skos:notation "cdm.base.staticdata.asset.common.EquityTypeEnum.DepositaryReceipt" ;
    skos:definition "Identifies a negotiable depositary receipt certificate issued by a bank representing shares in a foreign company traded on a local stock exchange." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum/ConvertiblePreference> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> ;
    rdfs:label "ConvertiblePreference" ;
    skos:notation "cdm.base.staticdata.asset.common.EquityTypeEnum.ConvertiblePreference" ;
    skos:definition "Identifies an Equity of Convertible Preference, a stock which can be converted into a predetermined number of common shares and holds priority to receive capital return in event of issuer liquidation." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/EquityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> a owl:Class , skos:Concept ;
    rdfs:label "CollateralEntityTypeEnum" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralEntityTypeEnum" ;
    skos:definition "Represents an enumeration list to identify the type of entity issuing or guaranteeing the collateral asset." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-asset-common-enum.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum/SupraNational> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> ;
    rdfs:label "SupraNational" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralEntityTypeEnum.SupraNational" ;
    skos:definition "Specifies international organisations and multilateral banks, entities constituted by treaties or with multiple sovereign members includes Multilateral development Banks." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum/SovereignCentralBank> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> ;
    rdfs:label "SovereignCentralBank" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralEntityTypeEnum.SovereignCentralBank" ;
    skos:definition "Specifies Sovereign, Government Debt Securities including Central Banks." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum/QuasiGovernment> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> ;
    rdfs:label "QuasiGovernment" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralEntityTypeEnum.QuasiGovernment" ;
    skos:definition "Specifies institutions or bodies, typically constituted by statute, with a function mandated by the government and subject to government supervision inclusive of profit- and non-profit making bodies. Includes the US Agencies and GSEs and the EU concept of public sector entities. Excluding any entities which are also Regional Government." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum/RegionalGovernment> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> ;
    rdfs:label "RegionalGovernment" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralEntityTypeEnum.RegionalGovernment" ;
    skos:definition "Specifies Regional Governments including states within countries, local authorities and municipalities." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum/Corporate> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> ;
    rdfs:label "Corporate" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralEntityTypeEnum.Corporate" ;
    skos:definition "Specifies corporate bodies including Banks." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum/Fund> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> ;
    rdfs:label "Fund" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralEntityTypeEnum.Fund" ;
    skos:definition "Specifies a vehicle (with or without separate legal personality) designed for the purposes of collective investment towards a defined investment goal." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum/SpecialPurposeVehicle> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> ;
    rdfs:label "SpecialPurposeVehicle" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralEntityTypeEnum.SpecialPurposeVehicle" ;
    skos:definition "Specifies a vehicle setup for the purpose of acquisition and financing of specific assets on a limited recourse basis. E.g. asset backed securities, including securitisations." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SupraNationalIssuerTypeEnum> a owl:Class , skos:Concept ;
    rdfs:label "SupraNationalIssuerTypeEnum" ;
    skos:notation "cdm.base.staticdata.asset.common.SupraNationalIssuerTypeEnum" ;
    skos:definition "Represents an enumeration list to identify the type of supranational entity issuing the asset." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-asset-common-enum.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SupraNationalIssuerTypeEnum/InternationalOrganisation> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/SupraNationalIssuerTypeEnum> ;
    rdfs:label "InternationalOrganisation" ;
    skos:notation "cdm.base.staticdata.asset.common.SupraNationalIssuerTypeEnum.InternationalOrganisation" ;
    skos:definition "Specifies International Financial Institution." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/SupraNationalIssuerTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/SupraNationalIssuerTypeEnum/MultilateralBank> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/SupraNationalIssuerTypeEnum> ;
    rdfs:label "MultilateralBank" ;
    skos:notation "cdm.base.staticdata.asset.common.SupraNationalIssuerTypeEnum.MultilateralBank" ;
    skos:definition "Specifies Multilateral Bank or Multilateral Development Bank." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/SupraNationalIssuerTypeEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum> a owl:Class , skos:Concept ;
    rdfs:label "DebtSeniorityEnum" ;
    skos:notation "cdm.base.staticdata.asset.common.DebtSeniorityEnum" ;
    skos:definition "Specifies the order of repayment in the event of a sale or bankruptcy of the issuer or a related party (eg guarantor)." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-asset-common-enum.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum/Secured> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum> ;
    rdfs:label "Secured" ;
    skos:notation "cdm.base.staticdata.asset.common.DebtSeniorityEnum.Secured" ;
    skos:definition "Denotes debt which is secured over assets of the issuer or a related party (eg guarantor)." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum/Senior> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum> ;
    rdfs:label "Senior" ;
    skos:notation "cdm.base.staticdata.asset.common.DebtSeniorityEnum.Senior" ;
    skos:definition "Denotes debt  which ranks pari passu with all other unsecured creditors of the issuer." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum/Subordinated> a owl:NamedIndividual , skos:Concept , <https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum> ;
    rdfs:label "Subordinated" ;
    skos:notation "cdm.base.staticdata.asset.common.DebtSeniorityEnum.Subordinated" ;
    skos:definition "Denotes debt  owed to an unsecured creditor that in the event of a liquidation can only be paid after the claims of secured and senior creditors have been met." ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/DebtSeniorityEnum> .

