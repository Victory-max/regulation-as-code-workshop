# A subset of the FINOS Common Domain Model (CDM) for the Fiction Bank policy workspace: the
# types, enumerations and attributes the policies' concepts and fields can be aligned to.
#
# Attribution (Community Specification License 1.0, section 1.2): derived from the FINOS Common
# Domain Model, Rosetta sources at commit ced66d4 (2026-10-28), retrieved from
# https://github.com/finos/common-domain-model. Licensed under the Community Specification
# License 1.0: https://github.com/finos/common-domain-model/blob/master/LICENSE.md
#
# CDM is defined in Rosetta DSL, not RDF. This file is a derived rendering: CDM types and
# enumerations are classes (and SKOS concepts), enumeration values are individuals, attributes
# are properties and SKOS concepts narrower than their type, so policy fields can be
# aligned to them. The IRIs are ours (cdm.finos.example), not official CDM identifiers; each
# resource points to its CDM source with rdfs:isDefinedBy. Use only the IRIs in this file.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cdm.finos.example/subset> a owl:Ontology ;
    rdfs:label "FINOS CDM subset (derived)" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> a owl:Class , skos:Concept ;
    rdfs:label "AssetType" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetType" ;
    skos:definition "Represents a class to allow specification of the asset product type." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-asset-common-type.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType/assetType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:label "AssetType.assetType" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetType.assetType" ;
    skos:definition "Represents a filter based on the type of collateral asset." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:range <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetTypeEnum> ;
    skos:scopeNote "cardinality 1..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType/securityType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:label "AssetType.securityType" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetType.securityType" ;
    skos:definition "Represents a filter based on the type of security." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:range <https://cdm.finos.example/cdm/base/staticdata/asset/common/SecurityTypeEnum> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType/debtType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:label "AssetType.debtType" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetType.debtType" ;
    skos:definition "Represents a filter based on the type of bond. (CDM type: DebtType)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType/equityType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:label "AssetType.equityType" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetType.equityType" ;
    skos:definition "Represents a filter based on the type of equity. (CDM type: EquityType)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType/fundType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:label "AssetType.fundType" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetType.fundType" ;
    skos:definition "Represents a filter based on the type of fund. (CDM type: FundProductTypeEnum)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType/otherAssetType> a owl:DatatypeProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:label "AssetType.otherAssetType" ;
    skos:notation "cdm.base.staticdata.asset.common.AssetType.otherAssetType" ;
    skos:definition "Specifies the eligible asset type when not enumerated." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/AssetType> ;
    rdfs:range xsd:string ;
    skos:scopeNote "cardinality 0..*" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> a owl:Class , skos:Concept ;
    rdfs:label "CollateralIssuerType" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralIssuerType" ;
    skos:definition "Represents a class to allow specification of the type of entity issuing the collateral." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-asset-common-type.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType/issuerType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    rdfs:label "CollateralIssuerType.issuerType" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralIssuerType.issuerType" ;
    skos:definition "Specifies the origin of entity issuing the collateral." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    rdfs:range <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralEntityTypeEnum> ;
    skos:scopeNote "cardinality 1..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType/supraNationalType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    rdfs:label "CollateralIssuerType.supraNationalType" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralIssuerType.supraNationalType" ;
    skos:definition "Specifies debt issued by international organisations and multilateral banks." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    rdfs:range <https://cdm.finos.example/cdm/base/staticdata/asset/common/SupraNationalIssuerTypeEnum> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType/quasiGovernmentType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    rdfs:label "CollateralIssuerType.quasiGovernmentType" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralIssuerType.quasiGovernmentType" ;
    skos:definition "Specifies debt issues by institutions or bodies, typically constituted by statute, with a function mandated by the government and subject to government supervision inclusive of profit- and non-profit making bodies. Includes the US Agencies and GSEs and the EU concept of public sector entities. Excluding any entities which are also Regional Government. (CDM type: QuasiGovernmentIssuerType)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType/regionalGovernmentType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    rdfs:label "CollateralIssuerType.regionalGovernmentType" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralIssuerType.regionalGovernmentType" ;
    skos:definition "Specifies Regional government, local authority or municipal. (CDM type: RegionalGovernmentIssuerType)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType/specialPurposeVehicleType> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    rdfs:label "CollateralIssuerType.specialPurposeVehicleType" ;
    skos:notation "cdm.base.staticdata.asset.common.CollateralIssuerType.specialPurposeVehicleType" ;
    skos:definition "Specifies a subsidiary company that is formed to undertake a specific business purpose of acquisition and financing of specific assets on a potentially limited recourse basis dependent of how it is designed. E.g. asset backed securities, including securitisations. (CDM type: SpecialPurposeVehicleIssuerType)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/asset/common/CollateralIssuerType> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> a owl:Class , skos:Concept ;
    rdfs:label "CollateralValuationTreatment" ;
    skos:notation "cdm.product.collateral.CollateralValuationTreatment" ;
    skos:definition "Specification of the valuation treatment for the specified collateral." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/product-collateral-type.rosetta> .

<https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment/haircutPercentage> a owl:DatatypeProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> ;
    rdfs:label "CollateralValuationTreatment.haircutPercentage" ;
    skos:notation "cdm.product.collateral.CollateralValuationTreatment.haircutPercentage" ;
    skos:definition "Specifies a haircut percentage to be applied to the value of asset and used as a discount factor to the value of the collateral asset,expressed as a percentage in decimal terms. As an example a 0.5% haircut would be represented as a decimal number 0.005." ;
    rdfs:domain <https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> ;
    rdfs:range xsd:decimal ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment/marginPercentage> a owl:DatatypeProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> ;
    rdfs:label "CollateralValuationTreatment.marginPercentage" ;
    skos:notation "cdm.product.collateral.CollateralValuationTreatment.marginPercentage" ;
    skos:definition "Specifies a percentage value of transaction needing to be posted as collateral expressed as a valuation. As an example a 104% requirement would be represented as a decimal number 1.04." ;
    rdfs:domain <https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> ;
    rdfs:range xsd:decimal ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment/fxHaircutPercentage> a owl:DatatypeProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> ;
    rdfs:label "CollateralValuationTreatment.fxHaircutPercentage" ;
    skos:notation "cdm.product.collateral.CollateralValuationTreatment.fxHaircutPercentage" ;
    skos:definition "Specifies an FX haircut applied to a specific asset which is agreed between the parties (for example, if pledgor eligible collateral is not denominated in the termination currency or under other specified cases in collateral support documents both for initial margin and variation margin).The percentage value is expressed as the discount haircut to the value of the collateral- as an example an 8% FX haircut would be expressed as 0.08." ;
    rdfs:domain <https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> ;
    rdfs:range xsd:decimal ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment/additionalHaircutPercentage> a owl:DatatypeProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> ;
    rdfs:label "CollateralValuationTreatment.additionalHaircutPercentage" ;
    skos:notation "cdm.product.collateral.CollateralValuationTreatment.additionalHaircutPercentage" ;
    skos:definition "Specifies a percentage value of any additional haircut to be applied to a collateral asset,the percentage value is expressed as the discount haircut to the value of the collateral- as an example a 5% haircut would be expressed as 0.05. " ;
    rdfs:domain <https://cdm.finos.example/cdm/product/collateral/CollateralValuationTreatment> ;
    rdfs:range xsd:decimal ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/event/common/Valuation> a owl:Class , skos:Concept ;
    rdfs:label "Valuation" ;
    skos:notation "cdm.event.common.Valuation" ;
    skos:definition "Defines the value of an investment, asset, or security" ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/event-common-type.rosetta> .

<https://cdm.finos.example/cdm/event/common/Valuation/amount> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:label "Valuation.amount" ;
    skos:notation "cdm.event.common.Valuation.amount" ;
    skos:definition "Current value of the outstanding contract" ;
    rdfs:domain <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:range <https://cdm.finos.example/cdm/observable/asset/Money> ;
    skos:scopeNote "cardinality 1..1" .

<https://cdm.finos.example/cdm/event/common/Valuation/timestamp> a owl:DatatypeProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:label "Valuation.timestamp" ;
    skos:notation "cdm.event.common.Valuation.timestamp" ;
    skos:definition "Date and time of the last valuation marked to market, provided by the central counterparty (CCP) or calculated using the current or last available market price of the inputs." ;
    rdfs:domain <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:range xsd:dateTime ;
    skos:scopeNote "cardinality 1..1" .

<https://cdm.finos.example/cdm/event/common/Valuation/method> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:label "Valuation.method" ;
    skos:notation "cdm.event.common.Valuation.method" ;
    skos:definition "Method used for the valuation of the transaction by the valuation party." ;
    rdfs:domain <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:range <https://cdm.finos.example/cdm/event/common/ValuationTypeEnum> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/event/common/Valuation/source> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:label "Valuation.source" ;
    skos:notation "cdm.event.common.Valuation.source" ;
    skos:definition "Source of the valuation of the transaction by the valuation party. (CDM type: ValuationSourceEnum)" ;
    rdfs:domain <https://cdm.finos.example/cdm/event/common/Valuation> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/event/common/Valuation/scope> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:label "Valuation.scope" ;
    skos:notation "cdm.event.common.Valuation.scope" ;
    skos:definition " Defines the scope of the valuation, what it applies to e.g. the collateral or the trade (CDM type: ValuationScopeEnum)" ;
    rdfs:domain <https://cdm.finos.example/cdm/event/common/Valuation> ;
    skos:scopeNote "cardinality 1..1" .

<https://cdm.finos.example/cdm/event/common/Valuation/delta> a owl:DatatypeProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:label "Valuation.delta" ;
    skos:notation "cdm.event.common.Valuation.delta" ;
    skos:definition "The ratio of the change in the price of a derivative transaction to the change in the price of the underlying. This field is applicable only to options and swaptions." ;
    rdfs:domain <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:range xsd:decimal ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/event/common/Valuation/valuationTiming> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:label "Valuation.valuationTiming" ;
    skos:notation "cdm.event.common.Valuation.valuationTiming" ;
    skos:definition "Denotes when the valuation was sourced during a business day. (CDM type: PriceTimingEnum)" ;
    rdfs:domain <https://cdm.finos.example/cdm/event/common/Valuation> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/event/common/Valuation/priceComponent> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/event/common/Valuation> ;
    rdfs:label "Valuation.priceComponent" ;
    skos:notation "cdm.event.common.Valuation.priceComponent" ;
    skos:definition "Denotes the price used to compute the valuation. (CDM type: Price)" ;
    rdfs:domain <https://cdm.finos.example/cdm/event/common/Valuation> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/observable/asset/Money> a owl:Class , skos:Concept ;
    rdfs:label "Money" ;
    skos:notation "cdm.observable.asset.Money" ;
    skos:definition "Defines a monetary amount in a specified currency." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/observable-asset-type.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/party/Counterparty> a owl:Class , skos:Concept ;
    rdfs:label "Counterparty" ;
    skos:notation "cdm.base.staticdata.party.Counterparty" ;
    skos:definition "Defines a counterparty enumerated value, e.g. Party1 or Party2, with an associated party reference. The product is agnostic to the actual parties to the transaction, with the party references abstracted away from the product definition and replaced by the CounterpartyEnum (e.g. values Party1 or Party2). The CounterpartyEnum can then be positioned in the product (e.g. to specify which counterparty is the payer, receiver etc) and this Counterparty type, which is positioned outside of the product definition, allows the CounterpartyEnum to be associated with an actual party reference." ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-party-type.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/party/Counterparty/role> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Counterparty> ;
    rdfs:label "Counterparty.role" ;
    skos:notation "cdm.base.staticdata.party.Counterparty.role" ;
    skos:definition "Specifies the CounterpartyEnum, e.g. either Party1 or Party2, that is associated to the partyReference." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Counterparty> ;
    rdfs:range <https://cdm.finos.example/cdm/base/staticdata/party/CounterpartyRoleEnum> ;
    skos:scopeNote "cardinality 1..1" .

<https://cdm.finos.example/cdm/base/staticdata/party/Counterparty/partyReference> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Counterparty> ;
    rdfs:label "Counterparty.partyReference" ;
    skos:notation "cdm.base.staticdata.party.Counterparty.partyReference" ;
    skos:definition "Specifies the party that is associated to the counterparty." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Counterparty> ;
    rdfs:range <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    skos:scopeNote "cardinality 1..1" .

<https://cdm.finos.example/cdm/base/staticdata/party/Party> a owl:Class , skos:Concept ;
    rdfs:label "Party" ;
    skos:notation "cdm.base.staticdata.party.Party" ;
    skos:definition "A class to specify a party, without a qualification as to whether this party is a legal entity or a natural person, although the model provides the ability to associate a person (or set of persons) to a party, which use case would imply that such party would be a legal entity (even if not formally specified as such). " ;
    rdfs:isDefinedBy <https://github.com/finos/common-domain-model/blob/ced66d4/rosetta-source/src/main/rosetta/base-staticdata-party-type.rosetta> .

<https://cdm.finos.example/cdm/base/staticdata/party/Party/partyId> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:label "Party.partyId" ;
    skos:notation "cdm.base.staticdata.party.Party.partyId" ;
    skos:definition "The identifier associated with a party, e.g. the 20 digits LEI code. (CDM type: PartyIdentifier)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    skos:scopeNote "cardinality 1..*" .

<https://cdm.finos.example/cdm/base/staticdata/party/Party/name> a owl:DatatypeProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:label "Party.name" ;
    skos:notation "cdm.base.staticdata.party.Party.name" ;
    skos:definition "The party name." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:range xsd:string ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/party/Party/businessUnit> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:label "Party.businessUnit" ;
    skos:notation "cdm.base.staticdata.party.Party.businessUnit" ;
    skos:definition "Optional organization unit information used to describe the organization units (e.g. trading desks) involved in a transaction or business process, incl. the contact information (when relevant). (CDM type: BusinessUnit)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    skos:scopeNote "cardinality 0..*" .

<https://cdm.finos.example/cdm/base/staticdata/party/Party/person> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:label "Party.person" ;
    skos:notation "cdm.base.staticdata.party.Party.person" ;
    skos:definition "The person(s) who might be associated with the party as part of the execution, contract or legal document. (CDM type: NaturalPerson)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    skos:scopeNote "cardinality 0..*" .

<https://cdm.finos.example/cdm/base/staticdata/party/Party/personRole> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:label "Party.personRole" ;
    skos:notation "cdm.base.staticdata.party.Party.personRole" ;
    skos:definition "The role of the person(s)  (CDM type: NaturalPersonRole)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    skos:scopeNote "cardinality 0..*" .

<https://cdm.finos.example/cdm/base/staticdata/party/Party/account> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:label "Party.account" ;
    skos:notation "cdm.base.staticdata.party.Party.account" ;
    skos:definition "The account that might be associated with the party. At most one account can be specified, as it is expected that this information is used in the context of a contract or legal document where only one account per party can be associated with such object." ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:range <https://cdm.finos.example/cdm/base/staticdata/party/Account> ;
    skos:scopeNote "cardinality 0..1" .

<https://cdm.finos.example/cdm/base/staticdata/party/Party/contactInformation> a owl:ObjectProperty , skos:Concept ;
    skos:broader <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    rdfs:label "Party.contactInformation" ;
    skos:notation "cdm.base.staticdata.party.Party.contactInformation" ;
    skos:definition "The postal/street address, telephone number, email address and/or web page. If the contact information is specific to the associated business unit(s) or person (s), it should be associated with those. (CDM type: ContactInformation)" ;
    rdfs:domain <https://cdm.finos.example/cdm/base/staticdata/party/Party> ;
    skos:scopeNote "cardinality 0..1" .

